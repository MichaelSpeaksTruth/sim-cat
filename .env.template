# ==============================================================================
# Sim-Cat Environment Configuration Template
# Use this template to configure deployment environments (Render, Cloud, Docker)
# For local overrides, copy this file to .env.local (which is git-ignored)
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Sim-Cat"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Gas-Solid Fixed-Bed Diagnostic Suite for Reaction Kinetics"

# Runtime & Server (Render Web Service / Static Site)
NODE_VERSION="22.16.0"
PORT=10000
HOST="0.0.0.0"

# Simulation Engine Defaults
VITE_DEFAULT_PRESET="benchmark_n2o"
VITE_ENABLE_ANALYTICS="false"
VITE_MAX_SWEEP_STEPS="50"

# Render Environment Indicator (e.g. 'production', 'staging', 'development')
RENDER="false"
NODE_ENV="production"
