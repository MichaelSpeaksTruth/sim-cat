# ==============================================================================
# Sim-Cat Environment Configuration Template (.env.example)
# Copy to .env.local for local development overrides
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Sim-Cat"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Gas-Solid Fixed-Bed Diagnostic Suite for Reaction Kinetics"

# Runtime & Server
NODE_VERSION="22.16.0"
PORT=10000
HOST="0.0.0.0"

# Simulation Configuration
VITE_DEFAULT_PRESET="benchmark_n2o"
VITE_ENABLE_ANALYTICS="false"
VITE_MAX_SWEEP_STEPS="50"

# Environment
NODE_ENV="production"
